# Recommended: OpenRouter (used when OPENAI_* are unset, or always
# in production-style config).
OPENROUTER_KEY=

##
## Optional keys to customize behavior
##

# Production-style overrides (used when dev-specific vars above are empty).
OPENAI_API_KEY=
# OpenAI-compatible API root. /v1 is appended automatically when omitted
# (e.g. https://aperture.example.ts.net → …/v1).
OPENAI_BASE_URL=

# Local / alternate endpoint (dev). When set with non-empty values, these
# override OPENAI_BASE_URL / keys in dev (`npm run dev` / `bun dev`). Set up
# Ollama with a local model so working on the app doesn't cost you $$
OPENAI_DEV_URL=
OPENAI_DEV_API_KEY=
OPENAI_DEV_KEY=
OCR_VLM_DEV_MODEL=
METADATA_LLM_DEV_MODEL=
# Optional OCR-only overrides in dev (fall back to OPENAI_DEV_* / shared vars).
OCR_VLM_DEV_URL=
OCR_VLM_DEV_API_KEY=

# Models (dev overrides use *_DEV_*; otherwise *_MODEL defaults apply in config).
OCR_VLM_MODEL=
# Optional OpenAI-compatible endpoint just for VLM OCR. When unset, OCR uses
# OPENAI_BASE_URL / OPENROUTER_KEY (or OPENAI_API_KEY). Use this to point OCR
# at Mistral (or another provider) while metadata stays on OpenAI/OpenRouter.
OCR_VLM_BASE_URL=
OCR_VLM_API_KEY=
# Per-page VLM OCR timeout in seconds (liter-llm default is 60; too short for
# slower vision models).
OCR_VLM_TIMEOUT_SECS=
METADATA_LLM_MODEL=
